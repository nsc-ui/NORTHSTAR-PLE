# Copy to local.env. NEVER commit benchmark/local.env.
# These values are provided by your authorized accounts/official proxy setup.
HF_TOKEN=hf_replace_with_your_read_token
MODEL_PROXY_URL=http://localhost:4000
MODEL_PROXY_KEY=replace_with_proxy_key
